Algoritmo "soma"

Var

   numero1, numero2, somaNumeros : inteiro

Inicio

   escreva("Digite um valor inteiro: ")
   leia(numero1)

   escreva("Digite outro valor inteiro: ")
   leia(numero2)
   
   somaNumeros <- numero1 + numero2
   
   escreval()
   escreval("CÁLCULO DE SOMA")
   escreval(numero1, " + ", numero2, " = ", somaNumeros)

Fimalgoritmo